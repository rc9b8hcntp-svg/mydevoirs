{
  "name": "cartable-os",
  "productName": "Cartable OS",
  "version": "1.0.0",
  "description": "Un OS pour le collège : écran d'accueil avec Word, Excel, PowerPoint, l'explorateur de fichiers, Mes Devoirs (à part ou intégré), et un emploi du temps (.ics) qui ouvre les dossiers des matières",
  "main": "main.js",
  "author": "Maxence",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.js",
    "prepare-devoirs": "node scripts/prepare-devoirs.js",
    "dist": "node scripts/prepare-devoirs.js && electron-builder --win msi --x64 --publish never"
  },
  "build": {
    "appId": "fr.maxence.cartableos",
    "productName": "Cartable OS",
    "copyright": "Maxence",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "ics.js",
      "scheduler.js",
      "apps.js",
      "devoirs-link.js",
      "devoirs-embed.js",
      "devoirs-embed-preload.js",
      "updates.js",
      "update-config.js",
      "build/update-repo.json",
      "mes-devoirs/updater.js",
      "mes-devoirs/downloader.js",
      "src/**/*",
      "mes-devoirs/backup.js",
      "mes-devoirs/notifier.js",
      "mes-devoirs/sync.js",
      "mes-devoirs/schedule-import.js",
      "mes-devoirs/src/**/*",
      "build/icon.png"
    ],
    "extraFiles": [
      {
        "from": "build/mes-devoirs-unpacked",
        "to": "Mes Devoirs"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": "msi"
    },
    "msi": {
      "artifactName": "CartableOS-${version}-${arch}.${ext}",
      "oneClick": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cartable OS",
      "runAfterFinish": true,
      "warningsAsErrors": false
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
