{
  "name": "mes-devoirs",
  "productName": "Mes Devoirs",
  "version": "1.0.0",
  "description": "Un logiciel simple pour noter ses devoirs",
  "main": "main.js",
  "author": "Maxence",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --ia32 --arm64",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --arm64",
    "dist:all": "electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "fr.maxence.mesdevoirs",
    "productName": "Mes Devoirs",
    "copyright": "Maxence",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "notifier.js",
      "backup.js",
      "downloader.js",
      "src/**/*",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": "msi"
    },
    "msi": {
      "artifactName": "MesDevoirs-${version}-${arch}.${ext}",
      "oneClick": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mes Devoirs",
      "runAfterFinish": true,
      "warningsAsErrors": false
    },
    "afterPack": "build/adhoc-sign.js",
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": "dmg",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "MesDevoirs-${version}-mac-${arch}.${ext}",
      "title": "Mes Devoirs ${version}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "Maxence <maxence@mesdevoirs.local>",
      "synopsis": "Noter ses devoirs",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "MesDevoirs-${version}-linux-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
