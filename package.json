{
  "name": "mes-devoirs",
  "productName": "Mes Devoirs",
  "version": "1.0.0",
  "description": "Un logiciel simple pour noter ses devoirs",
  "main": "main.js",
  "author": "Maxence",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --ia32 --arm64"
  },
  "build": {
    "appId": "fr.maxence.mesdevoirs",
    "productName": "Mes Devoirs",
    "copyright": "Maxence",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "src/**/*",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32", "arm64"]
        },
        {
          "target": "portable",
          "arch": ["x64", "ia32", "arm64"]
        }
      ],
      "artifactName": "MesDevoirs-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "MesDevoirs-Portable-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "MesDevoirs-Installeur-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "language": "1036"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
