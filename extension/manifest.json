{
  "manifest_version": 3,
  "name": "Mes Devoirs – Ajouter",
  "version": "1.2.0",
  "description": "Détecte automatiquement les devoirs sur Pronote et École Directe et les ajoute à Mes Devoirs en un clic (matière, date, priorité reconnues).",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ecoledirecte.com/*",
        "https://*.index-education.net/*",
        "https://*/pronote/*",
        "https://*/*/pronote/*"
      ],
      "js": [
        "quickadd.js",
        "shared.js",
        "detect.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:47653/*"
  ],
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "action": {
    "default_title": "Mes Devoirs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Ouvrir / fermer le panneau d'ajout sur la page"
    }
  }
}
